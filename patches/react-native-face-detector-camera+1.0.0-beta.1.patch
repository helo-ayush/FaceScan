+class FaceOverlayView(context: Context) : View(context) {
+    var isOverlayEnabled: Boolean = true
+        set(value) {
+            field = value
+            if (!value) {
+                isFaceDetected = false
+                currentRect = null
+                targetRect = null
+            }
+            postInvalidateOnAnimation()
+        }
+
+    var isSmooth: Boolean = true
