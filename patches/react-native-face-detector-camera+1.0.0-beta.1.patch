+/**
+ * The native frame pipeline deliberately passes data between small stages instead
+ * of doing work in the camera view. New work (blink/liveness, crop, embedding)
+ * can be inserted after alignment without changing detection or UI code.
+ */
+data class FacePipelineFrame(
+    val face: Face,
+    val imageWidth: Int,
+    val imageHeight: Int
+)
+
+data class FaceAlignment(
+    val isReady: Boolean,
+    val rotationDegrees: Float = 0f,
+    val scale: Float = 1f,
+    val eyeDistance: Float = 0f,
+    val sourceToCanonical: Matrix = Matrix()
+) {
+    fun toBundle(): Bundle {
+        val matrixValues = FloatArray(9)
+        sourceToCanonical.getValues(matrixValues)
+        return Bundle().apply {
+            putBoolean("isReady", isReady)
+            putDouble("rotationDegrees", rotationDegrees.toDouble())
+            putDouble("scale", scale.toDouble())
+            putDouble("eyeDistance", eyeDistance.toDouble())
+            putDoubleArray("sourceToCanonical", matrixValues.map { it.toDouble() }.toDoubleArray())
+        }
+    }
+}
+
+/**
+ * A compact, native-only normalized face image. Pixels are ARGB and remain on
+ * Android; JavaScript receives only the diagnostic bundle. A future TFLite
+ * stage can consume [pixels] directly without encoding a JPEG or crossing the
+ * React Native bridge.
+ */
+data class NormalizedFaceCrop(
+    val isReady: Boolean,
+    val width: Int = TARGET_SIZE,
+    val height: Int = TARGET_SIZE,
+    val coverage: Float = 0f,
+    val pixels: IntArray? = null,
+    val embedding: FloatArray? = null,
+    val processDurationMs: Long = 0L
+) {
+    fun toBundle(previewBase64: String? = null): Bundle = Bundle().apply {
+        putBoolean("isReady", isReady)
+        putInt("width", width)
+        putInt("height", height)
+        putDouble("coverage", coverage.toDouble())
+        previewBase64?.let { putString("previewBase64", it) }
+        embedding?.let { putDoubleArray("embedding", it.map { e -> e.toDouble() }.toDoubleArray()) }
+        putLong("processDurationMs", processDurationMs)
+    }
+
+    /** Debug only: turns the already-normalized pixels into a tiny JPEG. */
+    fun toJpegBase64(): String? {
+        val cropPixels = pixels ?: return null
+        val bitmap = Bitmap.createBitmap(cropPixels, width, height, Bitmap.Config.ARGB_8888)
+        return ByteArrayOutputStream().use { stream ->
+            bitmap.compress(Bitmap.CompressFormat.JPEG, 88, stream)
+            Base64.encodeToString(stream.toByteArray(), Base64.NO_WRAP)
+        }
+    }
+
+    private companion object {
+        const val TARGET_SIZE = 160
+    }
+}
+
+interface FacePipelineStage<Input, Output> {
+    fun process(input: Input): Output
+}
+
+/**
+ * Maps a face into a 112x112 canonical crop: eyes are level, at y=43, and are
+ * 46 pixels apart. The crop stage applies this matrix while sampling YUV, so
+ * no full-frame bitmap or intermediate rotated image is created.
+ */
+class LandmarkAlignmentStage : FacePipelineStage<FacePipelineFrame, FaceAlignment> {
+    override fun process(input: FacePipelineFrame): FaceAlignment {
+        val leftEye = input.face.getLandmark(FaceLandmark.LEFT_EYE)?.position
+        val rightEye = input.face.getLandmark(FaceLandmark.RIGHT_EYE)?.position
+
+        if (leftEye == null || rightEye == null) return FaceAlignment(isReady = false)
+
+        // ML Kit landmark names describe the subject, not the screen direction.
+        // Sort by image X so front/back camera input never produces an upside-down
+        // canonical crop merely because the preview is mirrored.
+        val (imageLeftEye, imageRightEye) = if (leftEye.x <= rightEye.x) {
+            leftEye to rightEye
+        } else {
+            rightEye to leftEye
+        }
+        val dx = imageRightEye.x - imageLeftEye.x
+        val dy = imageRightEye.y - imageLeftEye.y
+        val eyeDistance = hypot(dx.toDouble(), dy.toDouble()).toFloat()
+        if (eyeDistance < MIN_EYE_DISTANCE_PX) {
+            return FaceAlignment(isReady = false, eyeDistance = eyeDistance)
+        }
+        // Fix #3: degenerate case — eyes at identical position produces a
+        // garbled transform. Reject when dx and dy are both near-zero.
+        if (kotlin.math.abs(dx) < 1f && kotlin.math.abs(dy) < 1f) {
+            return FaceAlignment(isReady = false, eyeDistance = eyeDistance)
+        }
+
+        val eyeAngle = Math.toDegrees(atan2(dy.toDouble(), dx.toDouble())).toFloat()
+        val transform = Matrix()
+        transform.setPolyToPoly(
+            floatArrayOf(imageLeftEye.x, imageLeftEye.y, imageRightEye.x, imageRightEye.y),
+            0,
+            floatArrayOf(TARGET_LEFT_EYE_X, TARGET_EYE_Y, TARGET_RIGHT_EYE_X, TARGET_EYE_Y),
+            0,
+            2
+        )
+
+        return FaceAlignment(
+            isReady = true,
+            rotationDegrees = -eyeAngle,
+            scale = TARGET_EYE_DISTANCE / eyeDistance,
+            eyeDistance = eyeDistance,
+            sourceToCanonical = transform
+        )
+    }
+
+    private companion object {
+        const val MIN_EYE_DISTANCE_PX = 12f
+        const val TARGET_EYE_DISTANCE = 66f
+        const val TARGET_LEFT_EYE_X = 47f
+        const val TARGET_RIGHT_EYE_X = TARGET_LEFT_EYE_X + TARGET_EYE_DISTANCE
+        const val TARGET_EYE_Y = 61f
+    }
+}
+
+data class FaceCropInput(
+    val imageProxy: ImageProxy,
+    val imageRotationDegrees: Int,
+    val alignment: FaceAlignment
+)
+
+/**
+ * Produces the identity-model crop in one pass from YUV_420_888 to 112x112
+ * ARGB. An anti-spoof stage can later reuse the same source frame with its own
+ * padded crop policy, without affecting this identity crop.
+ */
+class NativeFaceCropStage : FacePipelineStage<FaceCropInput, NormalizedFaceCrop> {
+    // Fix #4: Reuse byte arrays across frames to avoid ~715 KB allocation per scan cycle
+    private var yBytes: ByteArray? = null
+    private var uBytes: ByteArray? = null
+    private var vBytes: ByteArray? = null
+    private val pixels = IntArray(TARGET_SIZE * TARGET_SIZE)
+    // Fix #6: Pre-allocate batch mapPoints array (25,600 points × 2 floats)
+    private val allPoints = FloatArray(TARGET_SIZE * TARGET_SIZE * 2)
+
+    override fun process(input: FaceCropInput): NormalizedFaceCrop {
+        if (!input.alignment.isReady) return NormalizedFaceCrop(isReady = false)
+
+        val canonicalToSource = Matrix()
+        if (!input.alignment.sourceToCanonical.invert(canonicalToSource)) {
+            return NormalizedFaceCrop(isReady = false)
+        }
+
+        val yPlane = input.imageProxy.planes[0]
+        val uPlane = input.imageProxy.planes[1]
+        val vPlane = input.imageProxy.planes[2]
+
+        // Fix #4: Reuse ByteArrays — only reallocate when buffer size changes
+        val yBuffer = yPlane.buffer.duplicate().apply { position(0) }
+        val uBuffer = uPlane.buffer.duplicate().apply { position(0) }
+        val vBuffer = vPlane.buffer.duplicate().apply { position(0) }
+
+        val yLen = yBuffer.remaining()
+        val uLen = uBuffer.remaining()
+        val vLen = vBuffer.remaining()
+        val yb = yBytes?.takeIf { it.size == yLen } ?: ByteArray(yLen).also { yBytes = it }
+        val ub = uBytes?.takeIf { it.size == uLen } ?: ByteArray(uLen).also { uBytes = it }
+        val vb = vBytes?.takeIf { it.size == vLen } ?: ByteArray(vLen).also { vBytes = it }
+        yBuffer.get(yb)
+        uBuffer.get(ub)
+        vBuffer.get(vb)
+
+        val yRowStride = yPlane.rowStride
+        val yPixelStride = yPlane.pixelStride
+        val uRowStride = uPlane.rowStride
+        val uPixelStride = uPlane.pixelStride
+        val vRowStride = vPlane.rowStride
+        val vPixelStride = vPlane.pixelStride
+
+        // Fix #6: Fill all output coordinates and batch-map in a single JNI call
+        for (outputY in 0 until TARGET_SIZE) {
+            for (outputX in 0 until TARGET_SIZE) {
+                val idx = (outputY * TARGET_SIZE + outputX) * 2
+                allPoints[idx] = outputX + 0.5f
+                allPoints[idx + 1] = outputY + 0.5f
+            }
+        }
+        canonicalToSource.mapPoints(allPoints) // Single JNI call for 25,600 points
+
+        val rawWidth = input.imageProxy.width
+        val rawHeight = input.imageProxy.height
+        val rotation = input.imageRotationDegrees
+        var sampledPixels = 0
+
+        for (outputY in 0 until TARGET_SIZE) {
+            for (outputX in 0 until TARGET_SIZE) {
+                val idx = (outputY * TARGET_SIZE + outputX) * 2
+                val rawPoint = orientedToRaw(
+                    allPoints[idx], allPoints[idx + 1], rotation,
+                    rawWidth, rawHeight
+                )
+                val index = outputY * TARGET_SIZE + outputX
+                if (rawPoint != null) {
+                    pixels[index] = sampleArgb(
+                        yb, yRowStride, yPixelStride,
+                        ub, uRowStride, uPixelStride,
+                        vb, vRowStride, vPixelStride,
+                        rawPoint.first, rawPoint.second
+                    )
+                    sampledPixels++
+                } else {
+                    pixels[index] = 0xFF000000.toInt()
+                }
+            }
+        }
+
+        return NormalizedFaceCrop(
+            isReady = sampledPixels > 0,
+            coverage = sampledPixels.toFloat() / pixels.size,
+            pixels = pixels.copyOf()  // Return a copy so the reused array isn't mutated later
+        )
+    }
+
+    // Fix #2: Corrected rotation mapping — use oriented dimensions, not raw dimensions
+    private fun orientedToRaw(
+        orientedX: Float,
+        orientedY: Float,
+        rotation: Int,
+        rawWidth: Int,
+        rawHeight: Int
+    ): Pair<Int, Int>? {
+        val orientedW = if (rotation == 90 || rotation == 270) rawHeight else rawWidth
+        val orientedH = if (rotation == 90 || rotation == 270) rawWidth else rawHeight
+        val x = orientedX.toInt()
+        val y = orientedY.toInt()
+        if (x < 0 || x >= orientedW || y < 0 || y >= orientedH) return null
+        val raw = when (rotation) {
+            90 -> (rawWidth - 1 - y) to x
+            180 -> (rawWidth - 1 - x) to (rawHeight - 1 - y)
+            270 -> y to (rawHeight - 1 - x)
+            else -> x to y
+        }
+        return raw.takeIf { (rawX, rawY) -> rawX in 0 until rawWidth && rawY in 0 until rawHeight }
+    }
+
+    // Fix #1: Added U/V bounds checking to prevent ArrayIndexOutOfBoundsException
+    private fun sampleArgb(
+        yBytes: ByteArray, yRowStride: Int, yPixelStride: Int,
+        uBytes: ByteArray, uRowStride: Int, uPixelStride: Int,
+        vBytes: ByteArray, vRowStride: Int, vPixelStride: Int,
+        x: Int, y: Int
+    ): Int {
+        val yIndex = y * yRowStride + x * yPixelStride
+        if (yIndex < 0 || yIndex >= yBytes.size) return 0xFF000000.toInt()
+        val yValue = yBytes[yIndex].toInt() and 0xFF
+        val chromaX = x / 2
+        val chromaY = y / 2
+        val uIndex = chromaY * uRowStride + chromaX * uPixelStride
+        val vIndex = chromaY * vRowStride + chromaX * vPixelStride
+        // Fix #1: Bounds check — fall back to grayscale if chroma plane is exceeded
+        if (uIndex < 0 || uIndex >= uBytes.size || vIndex < 0 || vIndex >= vBytes.size) {
+            return (0xFF shl 24) or (yValue shl 16) or (yValue shl 8) or yValue
+        }
+        val uValue = uBytes[uIndex].toInt() and 0xFF
+        val vValue = vBytes[vIndex].toInt() and 0xFF
+
+        val c = (yValue - 16).coerceAtLeast(0)
+        val d = uValue - 128
+        val e = vValue - 128
+        val red = ((298 * c + 409 * e + 128) shr 8).coerceIn(0, 255)
+        val green = ((298 * c - 100 * d - 208 * e + 128) shr 8).coerceIn(0, 255)
+        val blue = ((298 * c + 516 * d + 128) shr 8).coerceIn(0, 255)
+        return (0xFF shl 24) or (red shl 16) or (green shl 8) or blue
+    }
+
+    private companion object {
+        const val TARGET_SIZE = 160
+    }
+}
