+class FaceEmbeddingStage(context: android.content.Context) : FacePipelineStage<NormalizedFaceCrop, FloatArray?> {
+    private var interpreter: org.tensorflow.lite.Interpreter? = null
+    // Fix #5: Pre-allocate TFLite input buffer once (307 KB) instead of per-call
+    private val inputBuffer = java.nio.ByteBuffer.allocateDirect(1 * 160 * 160 * 3 * 4)
+        .apply { order(java.nio.ByteOrder.nativeOrder()) }
+    private val outputBuffer = Array(1) { FloatArray(512) }
+
+    init {
+        try {
+            val fileDescriptor = context.assets.openFd("mobilefacenet.tflite")
+            val inputStream = java.io.FileInputStream(fileDescriptor.fileDescriptor)
+            val fileChannel = inputStream.channel
+            val startOffset = fileDescriptor.startOffset
+            val declaredLength = fileDescriptor.declaredLength
+            val modelBuffer = fileChannel.map(java.nio.channels.FileChannel.MapMode.READ_ONLY, startOffset, declaredLength)
+            
+            val options = org.tensorflow.lite.Interpreter.Options()
+            options.setNumThreads(4)
+            interpreter = org.tensorflow.lite.Interpreter(modelBuffer, options)
+            android.util.Log.d("FaceEmbedding", "TFLite model (512-dim) loaded successfully from assets.")
+        } catch (e: Exception) {
+            android.util.Log.e("FaceEmbedding", "Failed to load TFLite model from assets: ${e.message}")
+        }
+    }
+
+    override fun process(input: NormalizedFaceCrop): FloatArray? {
+        val tflite = interpreter ?: return null
+        val pixels = input.pixels ?: return null
+        if (!input.isReady || pixels.size != 160 * 160) return null
+
+        // Fix #5: Rewind pre-allocated buffer instead of allocating new one
+        inputBuffer.rewind()
+
+        // Standard FaceNet input preprocessing: pixel values normalized to float between -1.0 and 1.0
+        // Formula: (pixel - 127.5f) / 128.0f
+        for (pixel in pixels) {
+            val r = ((pixel shr 16) and 0xFF)
+            val g = ((pixel shr 8) and 0xFF)
+            val b = (pixel and 0xFF)
+            
+            inputBuffer.putFloat((r - 127.5f) / 128.0f)
+            inputBuffer.putFloat((g - 127.5f) / 128.0f)
+            inputBuffer.putFloat((b - 127.5f) / 128.0f)
+        }
+
+        tflite.run(inputBuffer, outputBuffer)
+
+        // L2 normalization of output embedding vector
+        val embedding = outputBuffer[0]
+        var sum = 0f
+        for (val1 in embedding) {
+            sum += val1 * val1
+        }
+        val norm = kotlin.math.sqrt(sum)
+        if (norm > 0f) {
+            for (i in embedding.indices) {
+                embedding[i] /= norm
+            }
+        }
+
+        return embedding.copyOf()  // Return copy since outputBuffer is reused
+    }
+}
+
+class FacePipeline(context: android.content.Context) {
+    private val alignmentStage = LandmarkAlignmentStage()
+    private val cropStage = NativeFaceCropStage()
+    private val embeddingStage = FaceEmbeddingStage(context)
+    private var lastEmbeddingMillis = 0L
+    private var lastEmbedding: FloatArray? = null
+    private var lastDurationMs = 0L
+    private var lastNormalizationBundle: Bundle? = null
+
+    fun process(face: Face, imageWidth: Int, imageHeight: Int): FaceAlignment =
+        alignmentStage.process(FacePipelineFrame(face, imageWidth, imageHeight))
+
+    /**
+     * Only performs the expensive 160x160 crop + TFLite inference when the
+     * embedding throttle interval (500ms) has elapsed. Returns null on
+     * throttled frames so the caller can use [cachedNormalizationBundle]
+     * instead, avoiding all crop work.
+     */
+    fun cropIfNeeded(
+        imageProxy: ImageProxy,
+        imageRotationDegrees: Int,
+        alignment: FaceAlignment,
+        scanningIntervalMs: Long = 500L
+    ): NormalizedFaceCrop? {
+        val now = System.currentTimeMillis()
+        if (now - lastEmbeddingMillis < scanningIntervalMs) {
+            return null  // skip crop entirely on throttled frames
+        }
+        lastEmbeddingMillis = now
+
+        val cropResult = cropStage.process(FaceCropInput(imageProxy, imageRotationDegrees, alignment))
+        if (!cropResult.isReady) return cropResult
+
+        val startTime = System.currentTimeMillis()
+        val embedding = embeddingStage.process(cropResult)
+        val durationMs = System.currentTimeMillis() - startTime
+        lastEmbedding = embedding
+        lastDurationMs = durationMs
+
+        val result = cropResult.copy(embedding = embedding, processDurationMs = durationMs)
+        lastNormalizationBundle = result.toBundle(null)
+        return result
+    }
+
+    /**
+     * Returns the cached normalization Bundle from the last successful
+     * crop+embedding run. Used on throttled frames to avoid re-serializing.
+     */
+    // Fix #9: Cache the fallback Bundle to avoid allocating a new one every throttled frame
+    private var fallbackBundle: Bundle? = null
+
+    fun cachedNormalizationBundle(): Bundle {
+        lastNormalizationBundle?.let { return it }
+        // Build fallback once and cache it
+        val fb = fallbackBundle ?: Bundle().apply {
+            putBoolean("isReady", false)
+            putInt("width", 160)
+            putInt("height", 160)
+            putDouble("coverage", 0.0)
+        }.also { fallbackBundle = it }
+        // Update mutable fields on the cached bundle
+        fb.putLong("processDurationMs", lastDurationMs)
+        lastEmbedding?.let { fb.putDoubleArray("embedding", it.map { e -> e.toDouble() }.toDoubleArray()) }
+        return fb
+    }
+}
