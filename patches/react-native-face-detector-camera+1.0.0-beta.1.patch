@@ -0,0 +1,65 @@
+package com.facedetectorcamera
+
+import org.junit.Test
+import org.junit.Assert.*
+
+class RotationGeometryTest {
+
+    private fun orientedToRaw(
+        orientedX: Float,
+        orientedY: Float,
+        rotation: Int,
+        rawWidth: Int,
+        rawHeight: Int
+    ): Pair<Int, Int>? {
+        val orientedW = if (rotation == 90 || rotation == 270) rawHeight else rawWidth
+        val orientedH = if (rotation == 90 || rotation == 270) rawWidth else rawHeight
+
+        if (orientedX < 0f || orientedX >= orientedW || orientedY < 0f || orientedY >= orientedH) {
+            return null
+        }
+
+        val raw = when (rotation) {
+            0 -> Pair(orientedX.toInt(), orientedY.toInt())
+            90 -> Pair(orientedY.toInt(), (rawHeight - 1 - orientedX).toInt())
+            180 -> Pair((rawWidth - 1 - orientedX).toInt(), (rawHeight - 1 - orientedY).toInt())
+            270 -> Pair((rawWidth - 1 - orientedY).toInt(), orientedX.toInt())
+            else -> Pair(orientedX.toInt(), orientedY.toInt())
+        }
+
+        return if (raw.first in 0 until rawWidth && raw.second in 0 until rawHeight) raw else null
+    }
+
+    @Test
+    fun testRotation0() {
+        val res = orientedToRaw(10f, 20f, 0, 100, 200)
+        assertNotNull(res)
+        assertEquals(10, res!!.first)
+        assertEquals(20, res.second)
+    }
+
+    @Test
+    fun testRotation90() {
+        // Raw: 100x200. Rotation 90 means Oriented is 200x100.
+        val res = orientedToRaw(0f, 0f, 90, 100, 200)
+        assertNotNull(res)
+        assertEquals(0, res!!.first)
+        assertEquals(199, res.second)
+    }
+
+    @Test
+    fun testRotation180() {
+        val res = orientedToRaw(0f, 0f, 180, 100, 200)
+        assertNotNull(res)
+        assertEquals(99, res!!.first)
+        assertEquals(199, res.second)
+    }
+
+    @Test
+    fun testRotation270() {
+        val res = orientedToRaw(0f, 0f, 270, 100, 200)
+        assertNotNull(res)
+        assertEquals(99, res!!.first)
+        assertEquals(0, res.second)
+    }
+}
