+        val pixels = IntArray(TARGET_SIZE * TARGET_SIZE)
+        val point = FloatArray(2)
+        var sampledPixels = 0
+
+        for (outputY in 0 until TARGET_SIZE) {
+            for (outputX in 0 until TARGET_SIZE) {
+                point[0] = outputX + 0.5f
+                point[1] = outputY + 0.5f
+                canonicalToSource.mapPoints(point)
+                val rawPoint = orientedToRaw(
+                    point[0], point[1], input.imageRotationDegrees,
+                    input.imageProxy.width, input.imageProxy.height
+                )
+                val index = outputY * TARGET_SIZE + outputX
+                if (rawPoint != null) {
+                    pixels[index] = sampleArgb(input.imageProxy, rawPoint.first, rawPoint.second)
+                    sampledPixels++
+                } else {
+                    pixels[index] = 0xFF000000.toInt()
+                }
+            }
+        }
+
+        return NormalizedFaceCrop(
+            isReady = sampledPixels > 0,
+            coverage = sampledPixels.toFloat() / pixels.size,
+            pixels = pixels
+        )
+    }
