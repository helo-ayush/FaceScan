+
+    private val textPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+        color = Color.WHITE
+        textSize = 24f
+        isFakeBoldText = true
+    }
+
+    fun updateFace(
+        rect: RectF?,
+        imageWidth: Int,
+        imageHeight: Int,
+        isMirrored: Boolean
