{
  "expo": {
    "name": "ScanAttend",
    "slug": "scanattend",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "scanattend",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#faf8ff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#faf8ff"
      },
      "package": "com.anonymous.facewmobile"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-face-detector-camera",
        {
          "cameraPermission": "Allow ScanAttend to use the camera for face detection."
        }
      ],
      "expo-sqlite",
      "expo-secure-store"
    ]
  }
}
